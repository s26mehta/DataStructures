import random
import heapq

class Solution():
    def __init__(self):
        self.master_db = {}
        self.transaction_db = {}
        self.key_read_set = set()
        self.key_write_set = set()
    
    def begin(self):
        txn_id = random.random()
        self.transaction_db[txn_id] = {}
        return random.int
    
    def read(self, txn_id, key):
        if txn_id in self.transaction_db:
            if key in self.key_write_set and key not in self.transaction_db[txn_id]:
                raise Exception("Unable to read for key %s due to pending transaction", key)
            elif key in self.transaction_db[txn_id]:
                return self.transaction_db[txn_id][key]
        else:
            return self.master_db[key]
            self.key_read_set(key)
    
    def write(self, txn_id, key, value):
        if txn_id not in self.transaction_db:
            self.transaction_db[txn_id] = {}
            
        if key in self.key_read_set and key not in self.transaction_db[txn_id]:
            raise Exception("Unable to write for key %s due to pending update")
            del self.transaction_db[txn_id]
        else:
            self.transaction_db[txn_id][key] = value
            self.key_write_set.add(key)
        
    def commit(self, txn_id):
        transactions = self.transaction_db[txn_id]
        for key, value in transactions.items():
            self.master_db[key] = value
            self.key_used_set.discard(key)
        del self.transaction_db[txn_id]

